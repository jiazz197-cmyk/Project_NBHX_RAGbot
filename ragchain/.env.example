# ragchain 容器配置示例（对齐 .dsh/ragchain-interfaces.md §1 / 计划 §4.2.1）
# 复制为 .env 后填写；密钥类键全部留空占位。
# ---- server ----
RAGCHAIN_HOST=0.0.0.0
RAGCHAIN_PORT=8000
RAGCHAIN_LOG_LEVEL=INFO
SECRET_KEY=
ALGORITHM=HS256
MAIN_APP_BASE_URL=http://host.docker.internal:8000/api/v1
OUTBOUND_HTTP_TIMEOUT_SEC=30

# ---- main llm ----
MAIN_LLM_API_URL=
MAIN_LLM_MODEL=qwen3.8-27b
MAIN_LLM_API_KEY=
LANGCHAIN_CHAT_TIMEOUT_SEC=300
LANGCHAIN_MAX_OUTPUT_TOKENS=4096
MAIN_LLM_TEMPERATURE=0.3

# ---- sub llm ----
SUB_LLM_API_URL=
SUB_LLM_MODEL=
SUB_LLM_API_KEY=
SUB_LLM_ENABLE_THINKING=False
SUB_LLM_TIMEOUT_SEC=60
SUB_LLM_TEMPERATURE=0.1

# ---- reranker ----
RERANKER_API_URL=http://172.28.16.50:8096/v1/rerank
RERANKER_MODEL_NAME=bge-reranker-v2-m3
AI_INFERENCE_API_KEY=
RERANKER_TIMEOUT_SEC=30

# ---- web search ----
SEARCH_ENGINE_URL=http://10.80.153.12:8080/search
SEARCH_RESULT_COUNT=5
SEARCH_TIMEOUT_SEC=15

# ---- retrieval ----
DOC_COLLECTION=knowledge_chunks
EXCEL_COLLECTION=excel_db_chunks
RAG_RETRIEVE_TOP_K=10
RAG_RERANK_TOP_N=5

# ---- memory ----
MEMORY_RECENT_TURNS=10
MEMORY_COMPRESS_THRESHOLD=20
MEMORY_COMPRESS_N_RECENT=5

# ---- excel context ----
EXCEL_CONTEXT_MAX_CHARS=8000

# ---- sandbox python tool ----
TOOL_MAX_ITERATIONS=3
TOOL_EXEC_TIMEOUT_SEC=10
TOOL_CODE_MAX_CHARS=8000
TOOL_OUTPUT_MAX_CHARS=4000

# ---- sse / task registry / guard ----
SSE_HEARTBEAT_SEC=15
TASK_REGISTRY_TTL_SEC=600
RAGCHAIN_GUARD_STRICT=False
