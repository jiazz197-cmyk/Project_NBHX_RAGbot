# Chat frontend (apps/chat) Vite env
# WARNING: 这些是占位值，真实凭据请勿提交；已泄露的密钥必须轮换
# 开发服务器端口
VITE_PORT=8888
# 前端请求用相对路径，由 Vite dev server 代理转发，避免 CORS
VITE_API_BASE_URL=/api/v1
# 主应用业务接口（登录、会话、聊天历史、知识库等），仅 vite.config.ts 使用。
# 前后端在同一 dev 容器（docker/compose.dev.yaml），容器内固定 8000，与宿主 API_PORT 无关
VITE_BACKEND_TARGET=http://127.0.0.1:8000
# ragchain 容器（仅聊天生成与停止两项接口：/chat-messages 与 /{task_id}/stop），
# 仅 vite.config.ts 使用；其余 /api/v1/* 仍走 VITE_BACKEND_TARGET。
# 本地宿主模式为 http://127.0.0.1:8010；dev 容器内经 compose environment 覆盖为
# http://host.docker.internal:8010
VITE_CHAT_ORCHESTRATOR_TARGET=http://127.0.0.1:8010
# 环境标识
VITE_ENV=development
# 登录接口相对路径
VITE_LOGIN_ENDPOINT=/auth/login
# 获取当前用户信息接口相对路径
VITE_ME_ENDPOINT=/auth/me
# token 在 localStorage 的 key
VITE_AUTH_TOKEN_KEY=nbhx_chat_token
# 用户设置在 localStorage 的 key
VITE_SETTINGS_STORAGE_KEY=nbhx_chat_settings
