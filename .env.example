PROJECT_NAME=Project NBHX
VERSION=0.1.0
DESCRIPTION=Project NBHX API
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

HOST=0.0.0.0
PORT=8000
# 生产环境请改为明确域名清单，例如: ["api.example.com"]
ALLOWED_HOSTS=["*"]
TRUST_PROXY_HEADERS=False
TRUSTED_PROXIES=["127.0.0.1","10.0.0.0/8"]

POSTGRES_SERVER=127.0.0.1
POSTGRES_USER=pguser
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=pgdb
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 注意：REDIS_URL 是 config.py 里的计算属性，由下面四个值自动拼接；
# 在 .env 里写 REDIS_URL 不生效，有密码请用 REDIS_PASSWORD。
REDIS_PASSWORD=
# REDIS_URL=redis://:your_redis_password@127.0.0.1:6379/0

MINIO_ENDPOINT=127.0.0.1:9000
# Optional public endpoint used when generating object URLs for external consumers (e.g. OCR service).
# If unset, MINIO_ENDPOINT is used.
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_SECURE=false
MINIO_BUCKET_NAME=nbhxdev

# 独立 tagger 容器（issue #10）：标签提取走 HTTP，主应用不再在进程内跑
# SentenceTransformer / KeyBERT（也不再需要 GPU）。默认地址与容器 compose 一致；
# 在 dev 容器里跑后端时要改成 http://host.docker.internal:8004/v1/tags
# （容器里的 localhost 不是宿主，docker/compose.dev.yaml 已内置该覆盖）。
TAGGER_ENDPOINT=http://localhost:8004/v1/tags
# 单请求超时 / 失败重试次数 / 重试间隔（秒）；仅传输层失败与 5xx/429 重试
TAGGER_TIMEOUT_SEC=30
TAGGER_MAX_RETRIES=2
TAGGER_RETRY_DELAY_SEC=1
# 启动探活超时（秒）：单次最小请求，不重试
TAGGER_PROBE_TIMEOUT_SEC=5.0
# 连续失败熔断：连续 N 次失败后冷却 M 秒，冷却期内直接走本地 CPU 兜底标签
TAGGER_FAILURE_THRESHOLD=3
TAGGER_COOLDOWN_SEC=60

# AI 推理网关（GPUStack）：BGE-M3 嵌入与 Reranker 共用地址与鉴权
BGE_M3_API_URL=http://<gpustack-host>:<port>/v1/embeddings
# 模型名必须与网关实际部署的 served-model-name 一致
BGE_M3_MODEL_NAME=bge-m3
# 嵌入接口调用参数：单请求超时 / 失败重试次数 / 重试间隔（秒）
BGE_M3_TIMEOUT_SEC=30
BGE_M3_MAX_RETRIES=3
BGE_M3_RETRY_DELAY_SEC=3
# 入库批量嵌入的条数：一次 HTTP 带一批（llama-index embed_batch_size，上限 2048）
BGE_M3_BATCH_SIZE=64
RERANKER_API_URL=http://<gpustack-host>:<port>/v1/rerank
RERANKER_MODEL_NAME=bge-reranker-v2-m3
# 网关 Bearer Key；留空则请求不带 Authorization（兼容无鉴权端点）
AI_INFERENCE_API_KEY=change_me_ai_inference_api_key
# ---- OpenAI 兼容 LLM 网关（Sophnet 等）：主/辅双模型 ----
# 主 LLM：对话/编排主模型；MODEL 必须与 curl -s "$MAIN_LLM_API_URL/models"
# 返回的 id 完全一致（区分大小写，例如 qwen3.8-27b）。
MAIN_LLM_API_URL=https://www.sophnet.com/api/open-apis/v1
MAIN_LLM_MODEL=qwen3.8-27b
MAIN_LLM_API_KEY=change_me_main_llm_api_key
# 辅 LLM：memory 压缩 / 用户画像生成等后台任务；通常与主 LLM 同网关同 Key，
# 模型更小（served id 区分大小写，例如 Sophnet 的 Qwen3.6-27B）。
SUB_LLM_API_URL=https://www.sophnet.com/api/open-apis/v1
SUB_LLM_MODEL=Qwen3.6-27B
SUB_LLM_API_KEY=change_me_sub_llm_api_key
# Qwen3 混合思考开关：False 时经 chat_template_kwargs.enable_thinking=false 下发（默认关闭）
SUB_LLM_ENABLE_THINKING=False

# ---- LangChain 聊天编排预留配置（当前仅预留，未实现） ----
# 默认关闭；未实现前六个聊天接口统一返回 501 CHAT_ORCHESTRATOR_NOT_CONFIGURED。
LANGCHAIN_CHAT_ENABLED=False
# OpenAI 兼容 LLM 根地址 / served model id；留空时实现方回退 MAIN_LLM_*。
LANGCHAIN_CHAT_BASE_URL=https://www.sophnet.com/api/open-apis/v1
LANGCHAIN_CHAT_MODEL=qwen3.8-27b
LANGCHAIN_CHAT_TIMEOUT_SEC=300
LANGCHAIN_MAX_CONTEXT_MESSAGES=50
LANGCHAIN_MAX_OUTPUT_TOKENS=4096

# 知识库上传大小上限（MB），超限返回 422
KNOWLEDGE_MAX_DOCUMENT_FILE_SIZE_MB=50
KNOWLEDGE_MAX_EXCEL_FILE_SIZE_MB=20

SECRET_KEY=change_me_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=360
INTERNAL_API_KEY=change_me_internal_api_key

# 非 superuser 检索白名单按接口分家：/retriever/db 仅放行文档集合；/retriever/excel 仅放行 Excel 集合
RETRIEVER_ALLOWED_DOCUMENT_COLLECTIONS=["knowledge_chunks"]
RETRIEVER_ALLOWED_EXCEL_COLLECTIONS=["excel_db_chunks"]

# ---- 混合检索（issue #16 路线 1：关键词/pg_trgm 字面路 + RRF 融合）----
# 默认关闭 = 纯向量（改造前行为）。开启后仅当请求带非空 keywords 才走双路召回，
# 不传 keywords 的旧调用行为不变。开启前建议先跑
# `python scripts/ensure_fulltext_index.py` 建好 pg_trgm GIN 索引。
# 决策记录与启用/回滚步骤：docs/retrieval-hybrid-fulltext.md
# RETRIEVAL_HYBRID_ENABLED=False
# RETRIEVAL_LEXICAL_TOP_K=10
# RETRIEVAL_RRF_K=60
# RETRIEVAL_MAX_KEYWORDS=12
# RETRIEVAL_KEYWORD_MAX_LEN=64
RATE_LIMIT_EXPENSIVE_AUTH=40
RATE_LIMIT_EXPENSIVE_ANON=5
RATE_LIMIT_FAIL_OPEN=True
RATE_LIMIT_REDIS_ERROR_STATUS=503


# 仅开发环境按需启用；生产环境建议不要配置引导超级管理员
# BOOTSTRAP_SUPERUSER_USERNAME=superuser
# BOOTSTRAP_SUPERUSER_EMAIL=superuser@example.com
# BOOTSTRAP_SUPERUSER_PASSWORD=change_me_superuser_password

ENABLE_RATE_LIMIT=True
ENABLE_REQUEST_SIZE_LIMIT=True
ENABLE_CACHE=False

# 通用页面权限管理框架：默认关闭。当前无页面 key / RBAC seed；
# 后续新增页面并补 seed/UI 入口后再置 True。
PAGE_PERMISSION_MANAGEMENT_ENABLED=False
RATE_LIMIT_AUTH=100
RATE_LIMIT_ANON=20
RATE_LIMIT_WINDOW=60

MAX_JSON_SIZE=5242880
MAX_FILE_SIZE=52428800
CACHE_TTL=3600

LOG_LEVEL=INFO

METRICS_REQUIRE_API_KEY=True
ENABLE_SECURITY_HEADERS=True
ENABLE_HSTS=True
HSTS_MAX_AGE=31536000
# HuggingFace Mirror
HF_ENDPOINT=https://hf-mirror.com

# Local Models GPU Configuration (仅 main.py 启动时的 CUDA 探测打印)
# 本地模型使用的GPU设备（不影响Docker部署的模型）
LOCAL_MODEL_GPU_DEVICE=3


# ==========================================================================
# 以下为 config.py 中可由环境变量覆盖、但默认未登记的运维调参项。
# 默认值与 config.py 一致；部署时按需取消注释并调整。
# ==========================================================================

# ---- DB 连接池（PostgreSQL，app/core/database.py 消费）----
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600
# REDIS_MAX_CONNECTIONS=10
# REDIS_HEALTH_CHECK_INTERVAL_SEC=30   # 出借前 PING 校验（对齐 PG pre-ping），0=关

# ---- 后台任务线程池（executor.py）----
# EXECUTOR_MAX_WORKERS=30

# ---- OCR 服务（独立 paddlex 容器，issue #1 服务化）----
# 进程内已无 paddle 依赖；无文本层的 PDF 页渲染成 PNG 后 base64 调该端点。
# 未配置 = OCR 禁用（PDF 仅走 pdfplumber 文本提取）。宿主跑后端用 localhost，
# dev 容器里由 compose.dev.yaml 覆盖为 host.docker.internal。
# PADDLE_OCR_ENDPOINT=http://localhost:9002/ocr
# 单页 OCR 的 HTTP 超时（实测 300DPI A4 扫描页 ~1.3s，读超时留足余量）
# OCR_HTTP_CONNECT_TIMEOUT=10.0
# OCR_HTTP_READ_TIMEOUT=300.0

# ---- HTTP 客户端 ----
# HTTP_CLIENT_TIMEOUT=30.0
# HTTP_CLIENT_MAX_CONNECTIONS=100
# HTTP_CLIENT_MAX_KEEPALIVE=20

# ---- MinIO 细项 ----
# MINIO_APP_ENDPOINT=127.0.0.1:9000
# MINIO_REGION=us-east-1
# MINIO_PRESIGN_EXPIRES_HOURS=12
# MINIO_PRESIGN_SECURE=
# MINIO_DOWNLOAD_TIMEOUT_SEC=60.0
# MinIO 幽灵文件对账（与 DB 比对删除未引用对象）。
# 扫描间隔与宽限期默认均为 3 天；因宽限期==间隔，孤儿对象最坏需约
# 2 个周期（≈6 天）才会被清理。如需更紧的清理，调小 GRACE 使其 < INTERVAL。
# MINIO_RECONCILE_INTERVAL_SEC=259200
# MINIO_RECONCILE_GRACE_SEC=259200
# MINIO_OCR_TEMP_BUCKET=
# MINIO_OCR_ENABLE_ANONYMOUS_BUCKET=False
# MINIO_OCR_ANONYMOUS_BUCKET=

# ---- 限流（额外分档）----
# RATE_LIMIT_AUTH_ADMIN=1200
# RATE_LIMIT_EXPENSIVE_AUTH_ADMIN=240

# ---- WebSocket 并发 ----
# WS_MAX_CONNECTIONS_PER_IP=20
# WS_MAX_MESSAGES_PER_MINUTE=120
# WS_MAX_CONNECTIONS_PER_USER=16
# WS_MAX_CONNECTIONS_PER_USER_ADMIN=64
# WS_MAX_TRACKED_IPS_FOR_COUNTERS=2000

# ---- 任务归属缓存 ----
# TASK_OWNER_CACHE_TTL_SEC=86400
# TASK_OWNER_CACHE_MAX=5000

# ---- 文档转换 ----
# LIBREOFFICE_SUBPROCESS_TIMEOUT_SEC=300

# ---- 日志轮转 ----
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# ---- 缓存 TTL 细项 ----
# CACHE_API_RESPONSE_TTL=300
# CACHE_JOB_STATUS_TTL=86400

# ---- 辅 LLM 思考开关（True=开启思考；默认 False 经 enable_thinking=false 下发）----
# SUB_LLM_ENABLE_THINKING=False
