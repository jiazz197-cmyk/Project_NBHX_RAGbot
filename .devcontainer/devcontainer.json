// =============================================================================
// VS Code Dev Container —— 复用 docker/compose.dev.yaml，不另起一套编排
//
// 用法：装扩展 `ms-vscode-remote.remote-containers` → 命令面板
//       「Dev Containers: Reopen in Container」（或右下角提示气泡）
//
// 前置：容器已由 `bash scripts/dev.sh docker up` 起好（本文件不负责构建镜像）。
//
// ⚠️ 两个已知注意点：
// 1) `remoteUser` 写的是数字 uid：镜像里没有为宿主 uid 建同名用户（entrypoint 用
//    setpriv 降到「/workspace 属主」的 uid）。如果你的 `id -u` 不是 1001，改成你的值，
//    否则 VS Code 保存文件会写出别人属主的文件。
// 2) 若 VS Code 自己起 compose（而不是 attach 到已有容器），它可能使用不同的
//    compose project 名 → 数据卷不同（缓存要重下一次），且与 dev.sh 起的容器抢端口。
//    最稳的做法：先 `dev.sh docker up`，再用
//    「Dev Containers: Attach to Running Container」选 yamato-<你的用户名>-dev-1。
// 3) VS Code Server 需要容器能访问 update.code.visualstudio.com；若公司网络拦了，
//    attach 会失败，此时用 Remote-SSH 在宿主编辑 + `dev.sh docker ...` 跑命令。
// =============================================================================
{
  "name": "yamato-${localEnv:USER}", // 尽量与 dev.sh 的 -p yamato-${USER} 对齐
  "dockerComposeFile": ["../docker/compose.dev.yaml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "1001", // ← 改成你的 `id -u`
  "shutdownAction": "none", // 关窗口不要停容器（容器由 dev.sh 管理）

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        // 容器里 python 就是 /opt/venv/bin/python，交给它自己找
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["."],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
